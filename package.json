{
  "name": "updatecli-action",
  "version": "1.0.0",
  "description": "GitHub Action to install Updatecli",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "prepare": "ncc build index.js -o dist --source-map --license licenses.txt",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "all": "npm run lint && npm run prepare && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/updatecli/updatecli-action.git"
  },
  "keywords": [],
  "author": "Updatecli",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/updatecli/updatecli-action/issues"
  },
  "jest": {
    "verbose": true,
    "modulePaths": [
      "<rootDir>"
    ],
    "transform": {},
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**"
    ]
  },
  "type": "module",
  "homepage": "https://github.com/updatecli/updatecli-action#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@vercel/ncc": "^0.45.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^48.0.1",
    "jest": "^30.5.2"
  }
}
